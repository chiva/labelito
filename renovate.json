{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>chiva/renovate-config",
    "local>chiva/renovate-config:python-app",
    "customManagers:dockerfileVersions",
    "customManagers:githubActionsVersions"
  ],
  "enabledManagers": [
    "pep621",
    "github-actions",
    "dockerfile",
    "npm",
    "custom.regex"
  ],
  "packageRules": [
    {
      "description": "Icon collections in their own PR, so a fetch-icons.sh failure is attributable.",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@fortawesome/fontawesome-free",
        "@material-symbols/svg-400",
        "@primer/octicons"
      ],
      "groupName": "icon collections"
    }
  ]
}
